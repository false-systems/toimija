/target/

# Sykli receipts — a local, content-addressed cache of what `sykli run` ran.
/.sykli/

# Live agent packet — regenerated by `toimija refresh`/`enter`, never committed.
.toimija/current.md
.toimija/current.json

# Per-session live packets and markers — generated by `toimija run`.
.toimija/sessions/

# Durable, bounded summaries of concluded sessions.
.toimija/history.jsonl
.toimija/history.lock

# The note for the next agent in this working copy — written by `toimija handover`.
.toimija/handover.json

# Harness run transcripts — generated, never committed. Ignored so
# a harness writing its own transcript does not invalidate the packet it verified.
.toimija/runs/

# Snapshot leases — written by `toimija snapshot --lease`.
.toimija/snapshots/

# Claude Code local settings and its atomic-write temp files
.claude/settings.local.json
.claude/settings.local.json.tmp.*
