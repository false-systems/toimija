{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://false.systems/schemas/work-correlation.v1.schema.json",
  "title": "False Systems work-to-PR correlation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "created_at",
    "spec",
    "work",
    "session",
    "worker_run",
    "origin",
    "destination",
    "commit",
    "pull_request",
    "evidence",
    "sauma"
  ],
  "properties": {
    "schema": { "const": "work-correlation.v1" },
    "created_at": { "type": "integer", "minimum": 0 },
    "spec": { "type": "string", "pattern": "^spec_" },
    "work": { "type": "string", "pattern": "^work_" },
    "session": { "type": "string", "pattern": "^[0-9]+-[0-9]+$" },
    "worker_run": { "type": "string", "pattern": "^run_" },
    "origin": { "type": "string", "pattern": "^rpoint_" },
    "destination": { "type": "string", "pattern": "^rpoint_" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]+$" },
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "number", "url", "ref", "grade"],
      "properties": {
        "provider": { "const": "github" },
        "repository": { "type": "string" },
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string" },
        "ref": { "type": "string", "pattern": "^github:" },
        "grade": { "const": "declared" }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ev_" }
    },
    "sauma": { "$ref": "sauma-envelope.v1.schema.json" }
  }
}
